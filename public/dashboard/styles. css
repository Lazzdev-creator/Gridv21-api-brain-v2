*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,Helvetica,sans-serif;
}

body{
background:#0b1020;
color:#fff;
}

header{
height:70px;
background:#121b33;
display:flex;
justify-content:space-between;
align-items:center;
padding:0 25px;
border-bottom:1px solid #24304d;
}

header h1{
font-size:24px;
}

header button{
padding:10px 18px;
border:none;
border-radius:8px;
background:#00b4ff;
color:#fff;
cursor:pointer;
font-weight:bold;
}

.container{
padding:25px;
}

.grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
gap:20px;
margin-bottom:30px;
}

.card{
background:#151d35;
border-radius:14px;
padding:20px;
box-shadow:0 0 15px rgba(0,0,0,.2);
}

.card h2{
font-size:16px;
color:#b8c2d8;
margin-bottom:10px;
}

.metric{
font-size:32px;
font-weight:bold;
color:#00b4ff;
}

.section{
background:#151d35;
border-radius:14px;
padding:20px;
margin-bottom:30px;
overflow-x:auto;
}

.section h2{
margin-bottom:15px;
}

table{
width:100%;
border-collapse:collapse;
}

th{
background:#1f2b48;
padding:12px;
text-align:left;
}

td{
padding:12px;
border-bottom:1px solid #24304d;
}

.status{
display:inline-block;
padding:5px 10px;
border-radius:20px;
background:#16a34a;
font-size:13px;
}

.os-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
gap:18px;
}

.os-card{
background:#1a2545;
padding:18px;
border-radius:12px;
}

.os-card h3{
margin-bottom:8px;
font-size:18px;
}

.os-card p{
color:#b8c2d8;
font-size:14px;
margin-bottom:6px;
}

.loading{
text-align:center;
padding:30px;
color:#9fb0d0;
}

@media(max-width:768px){

header{
flex-direction:column;
height:auto;
padding:15px;
gap:12px;
}

.metric{
font-size:26px;
}

.container{
padding:15px;
}

}
